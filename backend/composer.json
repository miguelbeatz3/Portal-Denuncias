{
    "name": "tcc/portal-denuncias",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "dompdf/dompdf": "^3.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi",
            "@php artisan filament:assets"
        ]
    }
}
